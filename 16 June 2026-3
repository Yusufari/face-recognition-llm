from deepface import DeepFace
import cv2
import matplotlib.pyplot as plt
from google.colab import files

print("=" * 60)
print("DAY 15 - VERSION D (DeepFace)")
print("16 June 2026")
print("Baymax with ACCURATE expression detection!")
print("=" * 60)

# 1. UPLOAD IMAGE
print("\n--- UPLOAD A FACE IMAGE ---")
uploaded = files.upload()

for filename in uploaded.keys():
    img_path = filename

# 2. DETECT EXPRESSION
print("\n--- BAYMAX ANALYSIS ---")
print("=" * 60)

try:
    # Analyze emotion
    result = DeepFace.analyze(img_path=img_path, actions=['emotion'], enforce_detection=False)
    
    # Get dominant emotion
    emotion = result[0]['dominant_emotion']
    emotions = result[0]['emotion']
    
    # Map to Baymax style
    emotion_map = {
        'happy': 'HAPPY 😊',
        'sad': 'SAD 😔',
        'angry': 'ANGRY 😠',
        'fear': 'SCARED 😨',
        'surprise': 'SURPRISED 😲',
        'neutral': 'NEUTRAL 😐',
        'disgust': 'DISGUSTED 🤢'
    }
    
    baymax_emotion = emotion_map.get(emotion, emotion)
    
    print(f"🤖 Baymax: I detect {baymax_emotion}")
    print(f"   Confidence: {emotions[emotion]:.2f}%")
    
    # Advice
    if emotion == 'happy':
        advice = "Keep smiling! It's good for your health! 😊"
    elif emotion == 'sad':
        advice = "I am here for you. Let's talk. 🤗"
    elif emotion == 'angry':
        advice = "Take a deep breath. Calm down. 🧘"
    elif emotion == 'fear':
        advice = "You are safe. I am here to protect you. 💪"
    elif emotion == 'surprise':
        advice = "Wow! That's unexpected! 😲"
    else:
        advice = "You seem calm. That's good!"
    
    print(f"   Baymax: {advice}")
    
    # Show all emotions
    print("\n--- EMOTION BREAKDOWN ---")
    for em, score in sorted(emotions.items(), key=lambda x: x[1], reverse=True):
        bar = "█" * int(score / 5)
        print(f"  {em}: {bar} {score:.1f}%")
    
    # Display image
    img = cv2.imread(img_path)
    img_rgb = cv2.cvtColor(img, cv2.COLOR_BGR2RGB)
    
    plt.figure(figsize=(8, 6))
    plt.imshow(img_rgb)
    plt.title(f"Baymax: {baymax_emotion}")
    plt.axis('off')
    plt.show()
    
except Exception as e:
    print(f"Error: {e}")
    print("Try with a clearer face image.")

print("\n✅ DAY 15 - VERSION D DONE!")
