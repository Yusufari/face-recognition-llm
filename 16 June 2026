import cv2
import numpy as np
import matplotlib.pyplot as plt
from google.colab import files
import face_recognition

print("=" * 60)
print("DAY 15 - FULL INTEGRATION")
print("16 June 2026")
print("Baymax: DETECT + EXPRESSION + RESPOND")
print("=" * 60)

# 1. UPLOAD YOUR FACE (for recognition)
print("\n--- STEP 1: UPLOAD YOUR FACE ---")
print("Baymax needs to know who you are")
uploaded_face = files.upload()

for filename in uploaded_face.keys():
    known_img = face_recognition.load_image_file(filename)
    known_encodings = face_recognition.face_encodings(known_img)

if len(known_encodings) > 0:
    known_encoding = known_encodings[0]
    print("✓ Your face has been saved!")
else:
    known_encoding = None
    print("❌ No face detected")

# 2. UPLOAD TEST IMAGE
print("\n--- STEP 2: UPLOAD A PHOTO TO ANALYZE ---")
print("Upload a photo for Baymax to analyze")
uploaded_test = files.upload()

for filename in uploaded_test.keys():
    test_path = filename

# 3. PROCESS THE IMAGE
print("\n--- STEP 3: BAYMAX ANALYSIS ---")
print("=" * 60)

test_img = face_recognition.load_image_file(test_path)
test_locations = face_recognition.face_locations(test_img)
test_encodings = face_recognition.face_encodings(test_img, test_locations)

# 4. DETECT EXPRESSION
def simple_expression_analysis(face_roi):
    """Simple expression detection"""
    gray = cv2.cvtColor(face_roi, cv2.COLOR_RGB2GRAY)
    
    avg_brightness = np.mean(gray)
    contrast = np.std(gray)
    
    if avg_brightness > 120 and contrast > 50:
        return "HAPPY 😊", (0, 255, 0), "Keep smiling! It's good for your health!"
    elif avg_brightness < 80 and contrast < 40:
        return "TIRED 😴", (0, 165, 255), "Please take a break and rest."
    elif contrast < 45:
        return "SAD 😔", (255, 0, 0), "I am here for you. Let's talk."
    else:
        return "NEUTRAL 😐", (255, 255, 0), "You seem calm. That's good!"

# 5. ANALYZE EACH FACE
img_display = cv2.cvtColor(test_img, cv2.COLOR_RGB2BGR)

for i, (location, encoding) in enumerate(zip(test_locations, test_encodings)):
    top, right, bottom, left = location
    
    # Check if known person
    if known_encoding is not None:
        distance = np.linalg.norm(known_encoding - encoding)
        is_known = distance < 0.6
        person_name = "Yusuf" if is_known else "Unknown"
    else:
        person_name = "Unknown"
    
    # Extract face region for expression
    face_roi = test_img[top:bottom, left:right]
    expression, color, advice = simple_expression_analysis(face_roi)
    
    # Draw on image
    cv2.rectangle(img_display, (left, top), (right, bottom), color, 3)
    cv2.putText(img_display, f"{person_name}: {expression}", 
                (left, top-10), cv2.FONT_HERSHEY_SIMPLEX, 0.6, color, 2)
    
    # Print results
    print(f"\nFace {i+1}:")
    print(f"  Person: {person_name}")
    print(f"  Expression: {expression}")
    print(f"  Baymax: {advice}")

# 6. DISPLAY
plt.figure(figsize=(10, 8))
plt.imshow(cv2.cvtColor(img_display, cv2.COLOR_BGR2RGB))
plt.title("Baymax Analysis Results", fontsize=14)
plt.axis('off')
plt.show()

