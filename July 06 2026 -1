import cv2
import numpy as np
import matplotlib.pyplot as plt
from google.colab import files
from skimage.feature import hog
from skimage import exposure

print("=" * 60)
print("📌 REVIEW - FACE DETECTION + HOG")
print("6 July 2026")
print("=" * 60)

# 1. UPLOAD GAMBAR
print("\n--- UPLOAD GAMBAR WAJAH ---")
uploaded = files.upload()

for filename in uploaded.keys():
    image_path = filename
    print(f"✅ Gambar: {filename}")

# 2. DETEKSI WAJAH
img = cv2.imread(image_path)
gray = cv2.cvtColor(img, cv2.COLOR_BGR2GRAY)
img_rgb = cv2.cvtColor(img, cv2.COLOR_BGR2RGB)

face_cascade = cv2.CascadeClassifier(cv2.data.haarcascades + 'haarcascade_frontalface_default.xml')
faces = face_cascade.detectMultiScale(gray, 1.1, 5)

print(f"\n✅ Ditemukan {len(faces)} wajah")

# 3. GAMBAR KOTAK
img_result = img_rgb.copy()
for (x, y, w, h) in faces:
    cv2.rectangle(img_result, (x, y), (x+w, y+h), (0, 255, 0), 3)

# 4. EKSTRAK HOG (dari wajah pertama)
if len(faces) > 0:
    x, y, w, h = faces[0]
    face_roi = gray[y:y+h, x:x+w]
    face_resized = cv2.resize(face_roi, (128, 128))

    hog_features, hog_image = hog(
        face_resized,
        orientations=9,
        pixels_per_cell=(8, 8),
        cells_per_block=(2, 2),
        visualize=True,
        feature_vector=True
    )

    hog_image_rescaled = exposure.rescale_intensity(hog_image, in_range=(0, 10))

    # 5. TAMPILKAN
    plt.figure(figsize=(12, 4))

    plt.subplot(1, 3, 1)
    plt.imshow(img_result)
    plt.title("Face Detection")
    plt.axis('off')

    plt.subplot(1, 3, 2)
    plt.imshow(face_resized, cmap='gray')
    plt.title("Wajah (128x128)")
    plt.axis('off')

    plt.subplot(1, 3, 3)
    plt.imshow(hog_image_rescaled, cmap='gray')
    plt.title("HOG Features")
    plt.axis('off')

    plt.tight_layout()
    plt.show()

    print(f"\n✅ HOG features: {len(hog_features)} angka")
    print("   Ini adalah 'sidik jari' dari wajahmu!")

else:
    print("❌ Tidak ada wajah terdeteksi")

print("\n" + "=" * 60)
print("✅ REVIEW SELESAI!")
print("Kamu masih ingat! Lanjutkan!")
print("=" * 60)
