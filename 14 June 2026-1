axes[1].imshow(last_display)
axes[1].set_title(f"Last Frame: {last_filename}")
axes[1].axis('off')

plt.tight_layout()
plt.show()

# Summary
recognized = sum(frame_results)
total = len(frame_results)
if total > 0:
    print(f"\n--- SUMMARY ---")
    print(f"Frames where YOU were recognized: {recognized}/{total}")
    print(f"Recognition rate: {recognized/total*100:.1f}%")

