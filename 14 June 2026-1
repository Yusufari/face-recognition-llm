import face_recognition

# 2. UPLOAD KNOWN FACE
print("\n--- UPLOAD YOUR FACE (Training) ---")
uploaded_known = files.upload()
known_path = list(uploaded_known.keys())[0]

known_img = face_recognition.load_image_file(known_path)
known_encodings = face_recognition.face_encodings(known_img)

if len(known_encodings) > 0:
    known_encoding = known_encodings[0]
    print("✓ Your face learned!")
else:
    known_encoding = None
    print("❌ No face detected")

# 3. UPLOAD VIDEO (or multiple images as frames)
print("\n--- UPLOAD VIDEO OR MULTIPLE IMAGES ---")
print("Option A: Upload a video file (MP4)")
print("Option B: Upload multiple images as frames")
print("\nUpload your file(s):")
uploaded_frames = files.upload()

# 4. PROCESS EACH FRAME
print("\n--- PROCESSING ---")

frame_results = []

for idx, filename in enumerate(uploaded_frames.keys()):
    print(f"Processing frame {idx+1}: {filename}")
    
    frame = face_recognition.load_image_file(filename)
    locations = face_recognition.face_locations(frame)
    encodings = face_recognition.face_encodings(frame, locations)
    
    frame_display = cv2.cvtColor(frame, cv2.COLOR_RGB2BGR)
    
    for (top, right, bottom, left) in locations:
        if known_encoding is not None and len(encodings) > 0:
            distance = np.linalg.norm(known_encoding - encodings[0])
            is_match = distance < 0.6
            
            if is_match:
                label = "YOU"
                color = (0, 255, 0)
                frame_results.append(True)
            else:
                label = "UNKNOWN"
                color = (0, 0, 255)
                frame_results.append(False)
        else:
            label = "?"
            color = (0, 0, 255)
            frame_results.append(False)
        
        cv2.rectangle(frame_display, (left, top), (right, bottom), color, 2)
        cv2.putText(frame_display, label, (left, top-5), 
                    cv2.FONT_HERSHEY_SIMPLEX, 0.4, color, 1)

# Show first and last frame
fig, axes = plt.subplots(1, 2, figsize=(12, 5))

# First frame
