print("✓ Ready")
import face_recognition

# 2. UPLOAD KNOWN FACE
print("\n--- UPLOAD YOUR FACE (The person to recognize) ---")
uploaded_known = files.upload()
known_path = list(uploaded_known.keys())[0]

# Process known face
known_img = face_recognition.load_image_file(known_path)
known_encodings = face_recognition.face_encodings(known_img)

if len(known_encodings) > 0:
    known_encoding = known_encodings[0]
    print("✓ Your face has been learned!")
else:
    print("❌ No face detected")
    known_encoding = None

# 3. UPLOAD TEST IMAGES (Like video frames)
print("\n--- UPLOAD MULTIPLE TEST IMAGES ---")
print("Upload 5-10 photos (some of you, some of others)")
uploaded_tests = files.upload()

# 4. SIMULATE REAL-TIME PROCESSING
print("\n--- SIMULATING REAL-TIME RECOGNITION ---")
print("Processing each image one by one...\n")

results = []

for idx, filename in enumerate(uploaded_tests.keys()):
    print(f"Frame {idx+1}: {filename}")
    
    test_img = face_recognition.load_image_file(filename)
    test_locations = face_recognition.face_locations(test_img)
    test_encodings = face_recognition.face_encodings(test_img, test_locations)
    
    # Draw on image
    test_display = cv2.cvtColor(test_img, cv2.COLOR_RGB2BGR)
    
    for (top, right, bottom, left) in test_locations:
        if known_encoding is not None and len(test_encodings) > 0:
            distance = np.linalg.norm(known_encoding - test_encodings[0])
            is_known = distance < 0.6
            
            if is_known:
                label = "YOU - RECOGNIZED"
                color = (0, 255, 0)
                results.append(True)
            else:
                label = "UNKNOWN PERSON"
                color = (0, 0, 255)
                results.append(False)
        else:
            label = "NO FACE"
            color = (255, 0, 0)
            results.append(False)
        
        cv2.rectangle(test_display, (left, top), (right, bottom), color, 3)
        cv2.putText(test_display, label, (left, top-10), 
                    cv2.FONT_HERSHEY_SIMPLEX, 0.5, color, 2)
    
    # Display frame
    plt.figure(figsize=(8, 6))
    plt.imshow(cv2.cvtColor(test_display, cv2.COLOR_BGR2RGB))
    plt.title(f"Frame {idx+1}: {label}")
    plt.axis('off')
    plt.show()
    
    time.sleep(0.5)  # Simulate real-time delay

# 5. SUMMARY
print("\n" + "=" * 60)
print("--- REAL-TIME SIMULATION SUMMARY ---")
print("=" * 60)

recognized_count = sum(results)
total_count = len(results)
print(f"You were recognized in {recognized_count} out of {total_count} frames")
print(f"Recognition rate: {recognized_count/total_count*100:.1f}%")

print("\n✅ DAY 13 - VERSION A DONE!")
